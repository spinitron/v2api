    "/shows": {
      "get": {
        "summary": "Returns scheduled shows optionally filtered by `{start}` and/or `{end}` date-times",
        "description": "In Spinitron, shows have recurrences which describe how the shows repeat in the overall program schedule. A recurrence expands over a period of time into a series of instances. Each instance corresponds to an episode of a show.\n\nThere are two ways to search the program schedule using `GET /shows`:\n1. **With** the query parameter `{end}` - returns **all** matching instances of shows up to the given end time.\n\n2. **Without** the `{end}` query parameter -\n    returns **only the first** instance of each matching show.\n\nRequest form **1** is useful to build displays of upcoming episodes of a show. For example `GET /shows?end=+1week` returns all the episodes of shows from now to one week from now. You could iterate the response items and convert them to boxes in a grid.\n\nRequest form **2** without `{end}` is unbounded – there's no limit to the number of matching instances – so it returns only the first instance for each matching show. Useful to make an alphabetical list fo shows, for example.\n\nIn the response, `items` is an array of objects, each object representing one instance of a scheduled show.\n\n`{start}` and/or `{end}` parameters must be no more than one hour in the past. An instance starting at `{end}` is included in the response. `items` can include instances that begin *or* end within the requested range. An instance that goes on air before `{start}` appears in `items` if it ends *after* but not *at* `{start}`. An instance starting at or before `{end}` is included.\n\nIf the request omits the `{start}` parameter, the server sets its value to the current time so that the filter range's start is always defined.\n\nObjects in `items` are ordered first by `datetime` and then by `id`.\n",
        "tags": [
          "Show"
        ],
        "parameters": [
          {
            "name": "start",
            "description": "Datetime from which to return items. At most 1 hour in the past.\n",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "description": "End datetime. At most 1 hour in the past.\n",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/expand"
          }
        ],
        "responses": {
          "200": {
            "description": "The shows",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseIndexResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Show"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseIndexResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Show"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Invalid datetimes in the filter: they are too old, or `{end}` is earlier than `{start}`.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
