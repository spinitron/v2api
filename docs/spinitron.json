        "tags": [
          "Show"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/expand"
          }
        ],
        "responses": {
          "200": {
            "description": "The Show",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Show"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Show"
                }
              }
            }
          },
          "404": {
            "description": "Show not found or too old",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/playlists": {
      "get": {
        "summary": "Returns playlists optionally filtered by {start} and/or {end} datetimes",
        "description": "Get playlists, optionally filtered by a datetime range.\nOnly past playlists are returned. A playlist up to 1 hour in the future is included. Ordered from newest to oldest.\n\nWith `future=1`, returns playlists that have not ended and are marked for public display before they air, including ones currently on air. `start` and `end` do not filter that result. Ordered from soonest to latest.\n",
        "tags": [
          "Playlist"
        ],
        "parameters": [
          {
            "name": "start",
            "description": "Datetime from which to return items. At most 1 hour in the future.\n",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "description": "End datetime. At most 1 hour in the future.\n",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "show_id",
            "description": "Filter by show",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "persona_id",
            "description": "Filter by persona",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "future",
            "description": "Set to `1` to list playlists that have not ended and are marked \"Display as a future public playlist\", including ones currently on air. `show_id` and `persona_id` still apply. `start` and `end` do not filter this result. Ordered from soonest to latest. Any other value leaves the default past-playlist list.\n",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            }
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/expand"
          }
        ],
        "responses": {
          "200": {
            "description": "The playlists",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseIndexResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Playlist"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/BaseIndexResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Playlist"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
